################################################################################
## ~/.inputrc
##
## Control the behaviour of the readline library used e.g.
## by the bash in the interactive mode for line editing.
## (The system key bindings from /etc/inputrc still apply.)
##
################################################################################

# Tab completion: ignore case, list all matches on the first Tab,
# colour them like ls, add a / to symlinked folders
set completion-ignore-case on
set show-all-if-ambiguous on
set colored-stats on
set mark-symlinked-directories on

# Up/Down: search history for commands starting with what is already typed
# (both cursor key modes, normal and application)
"\e[A": history-search-backward
"\e[B": history-search-forward
"\eOA": history-search-backward
"\eOB": history-search-forward
