// rofi configuration. Opened with Mod4+p (apps), Mod4+Shift+p (commands) and
// Mod4+Shift+Tab (windows). awesome adds -dpi so text matches its bar on each screen.
configuration {
    modi:               "drun,run,window";
    show-icons:         true;
    icon-theme:         "Adwaita";
    terminal:           "wezterm";
    drun-display-format: "{name}";
    display-drun:       "Apps";
    display-run:        "Run";
    display-window:     "Windows";
}

@theme "dracula"
