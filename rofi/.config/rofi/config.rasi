// rofi configuration. Opened with Mod4+p (apps) and Mod4+Shift+p (commands).
configuration {
    modi:               "drun,run,window";
    show-icons:         true;
    icon-theme:         "Adwaita";
    terminal:           "wezterm";
    drun-display-format: "{name}";
    display-drun:       "Apps";
    display-run:        "Run";
    display-window:     "Windows";
}

@theme "dracula"
